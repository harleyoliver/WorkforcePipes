{
  "properties": {
    "connectionReferences": {
      "shared_sendmail": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dev_sharedsendmail_15086"
        },
        "api": {
          "name": "shared_sendmail"
        }
      },
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dev_sharedcommondataserviceforapps_8c14d"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "a4a662b5-a5fa-4741-a3ed-d815d6dda7f0"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "dev_worker",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/runas": 3
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Initialize_employeeID": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "b1cd0d94-0508-48bf-b9c1-925dd7c9b301"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "employeeID",
                "type": "string",
                "value": "@{concat('AU-', utcNow('yy'), '-', rand(1000, 9999))}"
              }
            ]
          }
        },
        "Condition": {
          "actions": {
            "Send_an_email_notification_(V3)": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "40e06bcd-c9d1-49a9-a33d-1bfd163637ca"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sendmail",
                  "operationId": "SendEmailV3",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sendmail"
                },
                "parameters": {
                  "request/to": "@{triggerOutputs()?['body/dev_email']};",
                  "request/subject": "Welcome to the Team, @{triggerOutputs()?['body/dev_fullname']}!",
                  "request/text": "<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n    <div style=\"background-color: #0078d4; padding: 20px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 24px;\">Welcome to WorkforcePipes</h1>\n    </div>\n    \n    <div style=\"padding: 30px; color: #333; line-height: 1.6;\">\n        <p>Hi <strong>@{triggerOutputs()?['body/dev_fullname']}</strong>,</p>\n        \n        <p>Welcome to the team! We are excited to have you on board. Your profile has been successfully integrated into our management system.</p>\n        \n        <div style=\"background-color: #f3f2f1; padding: 15px; border-left: 5px solid #0078d4; margin: 20px 0;\">\n            <p style=\"margin: 0;\"><strong>Employee ID:</strong> <span style=\"color: #0078d4; font-family: monospace; font-size: 1.2em;\">@{variables('employeeID')}</span></p>\n            <p style=\"margin: 0;\"><strong>Onboarding Status:</strong>@{triggerOutputs()?['body/dev_status']}</p>\n        </div>\n\n        <p><strong>Next Steps:</strong></p>\n        <ul>\n            <li>Log in to the Workforce Portal using your email: <em>@{triggerOutputs()?['body/dev_email']}</em></li>\n            <li>Complete your <strong>White Card</strong> certification upload.</li>\n            <li>Review the Australian Safety Guidelines in your dashboard.</li>\n        </ul>\n        \n        <p>If you have any issues, please reply to this email to reach the IT Integration team.</p>\n        \n        <p>Best Regards,<br>\n        <strong>WorkforcePipes Automated System</strong></p>\n    </div>\n    \n    <div style=\"background-color: #faf9f8; padding: 15px; text-align: center; font-size: 12px; color: #666;\">\n        &copy; 2026 WorkforcePipes Australia | Technical Integration Lab\n    </div>\n</div>"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Initialize_employeeID": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@triggerOutputs()?['body/dev_status']",
              2
            ]
          },
          "metadata": {
            "operationMetadataId": "6abbe106-b4c6-450b-bef8-4bcf2e57abbe"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}